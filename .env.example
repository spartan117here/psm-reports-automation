# ==============================================================================
# Pothys Swarna Mahal Daily Reporting Automation - Environment Configuration
# COPY THIS FILE TO .env AND FILL IN AUTHORIZED PRODUCTION/DEV VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

# Innervex System Credentials & Connectivity
# Base URL for the internal Innervex instance (company LAN)
INNERVEX_BASE_URL=http://192.168.5.213:4499
# Legitimate authorized user credentials (used in Phase 1 once auth protocol is confirmed)
INNERVEX_USERNAME=your_authorized_username_here
INNERVEX_PASSWORD=your_authorized_password_here
INNERVEX_TIMEOUT_SECONDS=60
INNERVEX_MAX_RETRIES=3

# Google Sheets API Integration (Phase 5+)
# Path to service account JSON or OAuth client secrets
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/service_account.json
# Master Spreadsheet IDs (configured in Phase 5)
GOOGLE_SHEET_NEW_ENROLLMENT_ID=your_new_enrollment_spreadsheet_id_here
GOOGLE_SHEET_DIGI_GOLD_ID=your_digi_gold_spreadsheet_id_here
GOOGLE_SHEET_CLOSED_REJOINING_ID=your_closed_rejoining_spreadsheet_id_here

# Delivery Integration (Phase 11 - Disabled by default)
DELIVERY_ENABLED=false
DELIVERY_PRIMARY_CHANNEL=disabled
WHATSAPP_API_TOKEN=your_token_here
WHATSAPP_RECIPIENT_PHONE=your_phone_here
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=reports@pothysswarnamahal.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_RECIPIENTS=agm@pothysswarnamahal.com
